{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "A personal portfolio website to showcase my work and skills.",
  "homepage": "https://www.lukashufnagl.com",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.node.json && vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\"",
    "deploy": "gh-pages -d docs",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "vue": "^3.2.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.2",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.2"
  },
  "keywords": [
    "portfolio",
    "vue",
    "website"
  ],
  "author": "Lukas Hufnagl",
  "license": "UNLICENSED",
  "type": "module"
}
